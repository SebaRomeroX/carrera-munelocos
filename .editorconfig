# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false

[*.{js,css}]
indent_style = space
indent_size = 4

# index.html esta indentado con tabs
[*.html]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.json]
indent_style = space
indent_size = 4
